{
  "name": "taskent",
  "version": "0.2.0",
  "description": "One dashboard for all your AI coding agents — collector CLI. Reports task status from Claude Code / ZCode (MCP + hooks) to your taskent server; local queue first, async forward, offline replay, optional end-to-end encryption.",
  "type": "module",
  "license": "MIT",
  "author": "Mike",
  "homepage": "https://taskent.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhixiakj/taskent.mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zhixiakj/taskent.mcp/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "mcp",
    "task-tracker",
    "developer-tools",
    "dashboard",
    "cli",
    "hooks"
  ],
  "bin": {
    "taskent": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.2.0"
  }
}
